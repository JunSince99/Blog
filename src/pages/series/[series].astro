---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const seriesNames = [...new Set(allPosts.map(post => post.slug.split('/')[0]))];
  return seriesNames.map(name => ({ params: { series: name } }));
}

const { series } = Astro.params;
const allPosts = await getCollection('blog');
const seriesPosts = allPosts
  .filter(post => post.slug.startsWith(series))
  .sort((a, b) => a.data.order - b.data.order);

const seriesTitle = seriesPosts[0]?.data.seriesTitle || "Series";
---

<BaseLayout title={seriesTitle}>
  <section class="list-container">
    <div class="list-header">
      <span class="category">Series</span>
      <h1>{seriesTitle}</h1>
    </div>

    <div class="post-list">
      {seriesPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="post-item">
          <span class="post-order">{String(post.data.order).padStart(2, '0')}</span>
          <div class="post-content">
            <h2 class="post-title">{post.data.title}</h2>
            <p class="post-description">{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .list-header { margin-bottom: 40px; }
  .category { font-size: 0.75rem; color: #666; text-transform: uppercase; letter-spacing: 1px; }
  h1 { font-size: 1.8rem; font-weight: 800; margin: 10px 0 0 0; }

  .post-list { display: flex; flex-direction: column; gap: 8px; }
  .post-item { display: flex; gap: 20px; padding: 24px; text-decoration: none; color: inherit; border-radius: 12px; transition: background 0.2s; border: 1px solid transparent; }
  .post-item:hover { background: #0a0a0a; border-color: #1a1a1a; }
  .post-order { font-family: monospace; font-size: 1.1rem; color: #333; font-weight: 700; margin-top: 2px; }
  .post-title { font-size: 1.1rem; font-weight: 600; margin: 0 0 6px 0; }
  .post-description { font-size: 0.9rem; color: #666; margin: 0; line-height: 1.6; }
</style>