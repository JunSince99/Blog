---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Log.</title>
    </head>
  <body>
    <div class="container">
      <Header /> <main>
        <slot /> </main>

      <Footer /> </div>
  </body>
</html>

<style is:global>
  body {
    background-color: #000;
    color: #fff;
    margin: 0;
    font-family: 'Pretendard', sans-serif;
  }
  
  .container {
    width: 90%;
    max-width: 650px;
    margin: 0 auto;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1; /* 콘텐츠가 적어도 푸터가 바닥에 붙어 있게 함 */
  }
</style>